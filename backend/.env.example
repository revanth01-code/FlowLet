# Server
PORT=4000
NODE_ENV=development

# Host-side ports for Docker services. Override these if 27017 or 5434
# are already in use on your machine (e.g. a native Mongo/Postgres
# install), then update MONGO_URI / PGPORT below to match.
MONGO_PORT=27017
POSTGRES_PORT=5434

# MongoDB (flow definitions)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=flowlet

# PostgreSQL (run history)
PGHOST=localhost
PGPORT=5434
PGUSER=flowlet
PGPASSWORD=flowlet
PGDATABASE=flowlet

# Used to build the webhook URL shown in the UI
PUBLIC_BACKEND_URL=http://localhost:4000